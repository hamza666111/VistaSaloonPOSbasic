# Local-only by default. Leave these blank until configuring a NEW project.
VITE_ENABLE_REMOTE_SYNC=false
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional fictional data in development only; uses separate browser storage.
VITE_DEMO_MODE=false

# Used for local customer mobile numbers when opening manual WhatsApp chats.
VITE_WHATSAPP_DEFAULT_COUNTRY_CODE=92
